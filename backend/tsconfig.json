{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../",

    "paths": {
      "@/*": ["./src/*"],
      "@drizzle/*": ["./src/db/drizzle/*"],
      "@shared/*": ["../shared/*"]
    },

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
